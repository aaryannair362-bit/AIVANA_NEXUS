# Extraction provider: auto | ollama | gemini | deterministic
NEXUS_EXTRACTION_PROVIDER=auto

# --- Local Ollama extraction ---
# Only relevant when running on your own machine with `ollama serve` up.
# On Render (or any host without a local Ollama server), the app auto-detects
# the RENDER environment variable and skips the Ollama probe entirely, going
# straight to Gemini (if GEMINI_API_KEY is set) or the deterministic fallback.
# Set NEXUS_DISABLE_OLLAMA=1 to force that same skip on any other host.
NEXUS_OLLAMA_URL=http://127.0.0.1:11434
NEXUS_OLLAMA_MODEL=medgemma:4b
NEXUS_OLLAMA_TIMEOUT=180
# NEXUS_DISABLE_OLLAMA=1

# --- Gemini candidate-fact extraction (optional; never pathway authority) ---
# Leave GEMINI_API_KEY blank for local deterministic-only testing.
# On Render, set this in the dashboard's Environment tab (render.yaml marks it
# sync: false so it is never stored in the repo). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- UI/API host & port ---
# NEXUS_HOST/NEXUS_PORT are LOCAL DEV ONLY (read by tooling/dev.mjs and npm run dev).
# Render (and most PaaS hosts) inject their own PORT and require binding 0.0.0.0;
# render.yaml's startCommand already passes --host 0.0.0.0 --port $PORT directly,
# so nothing here needs to change for deployment.
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000

# No NEXUS_ENGINE_ROOT is needed: the exact deterministic engine is embedded at this repo root.
