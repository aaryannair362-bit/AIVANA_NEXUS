# Extraction provider: auto | ollama | gemini | deterministic
NEXUS_EXTRACTION_PROVIDER=auto

# Local Ollama extraction (optional, preferred by auto when available)
NEXUS_OLLAMA_URL=http://127.0.0.1:11434
NEXUS_OLLAMA_MODEL=medgemma:4b
NEXUS_OLLAMA_TIMEOUT=180

# Gemini candidate-fact extraction (optional; never pathway authority)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# UI/API
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000

# No NEXUS_ENGINE_ROOT is needed: the exact deterministic engine is embedded at this repo root.
